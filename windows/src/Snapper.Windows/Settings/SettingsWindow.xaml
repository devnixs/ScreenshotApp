<Window x:Class="Snapper.Windows.Settings.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Snapper.Core.Settings;assembly=Snapper.Core"
        xmlns:local="clr-namespace:Snapper.Windows.Settings"
        Title="Snapper Settings" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    </Window.Resources>
    <TabControl x:Name="Tabs" Margin="16" Focusable="True">
        <local:SettingsTabItem Header="General" Tag="{x:Static core:SettingsTab.General}">
            <StackPanel Margin="16">
                <CheckBox Content="Launch at login" IsChecked="{Binding LaunchAtLoginEnabled}" />
                <TextBlock Text="{Binding LaunchAtLoginNoteText}" Foreground="Gray" TextWrapping="Wrap" Margin="0,5,0,0" />
                <Button Content="Open Startup Apps" HorizontalAlignment="Left" Margin="0,4,0,0" Click="OpenStartupApps"
                        Visibility="{Binding ShowsOpenStartupApps, Converter={StaticResource BoolVisibility}}" />
                <TextBlock Text="Save folder" FontWeight="SemiBold" Margin="0,20,0,5" />
                <TextBlock Text="{Binding SaveFolderPath}" ToolTip="{Binding SaveFolderPath}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <Button Content="Choose…" Click="ChooseFolder" Padding="10,3" Margin="0,0,8,0" />
                    <Button Content="Open folder" Click="OpenFolder" Padding="10,3" />
                </StackPanel>
                <TextBlock Text="Screenshot destination" FontWeight="SemiBold" Margin="0,20,0,5" />
                <RadioButton Content="Save to file" IsChecked="{Binding DestinationFile}" Margin="0,3" GroupName="Destination" />
                <RadioButton Content="Copy to clipboard" IsChecked="{Binding DestinationClipboard}" Margin="0,3" GroupName="Destination" />
                <RadioButton Content="Both" IsChecked="{Binding DestinationBoth}" Margin="0,3" GroupName="Destination" />
                <CheckBox Content="Play shutter sound" IsChecked="{Binding PlayShutterSound}" Margin="0,20,0,0" />
            </StackPanel>
        </local:SettingsTabItem>
        <local:SettingsTabItem Header="Shortcuts" Tag="{x:Static core:SettingsTab.Shortcuts}">
            <StackPanel x:Name="ShortcutRows" Margin="16" />
        </local:SettingsTabItem>
        <local:SettingsTabItem Header="Recording" Tag="{x:Static core:SettingsTab.Recording}">
            <StackPanel Margin="16">
                <TextBlock Text="Format" FontWeight="SemiBold" Margin="0,0,0,5" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <RadioButton Content="{Binding FormatMp4Title}" IsChecked="{Binding FormatMp4}" GroupName="Format" Margin="0,0,16,0" />
                    <RadioButton Content="{Binding FormatGifTitle}" IsChecked="{Binding FormatGif}" GroupName="Format" />
                </StackPanel>
                <TextBlock Text="Quality" FontWeight="SemiBold" Margin="0,0,0,5" />
                <RadioButton Content="{Binding QualityHighTitle}" IsChecked="{Binding QualityHigh}" Margin="0,3" GroupName="Quality" />
                <RadioButton Content="{Binding QualityMediumTitle}" IsChecked="{Binding QualityMedium}" Margin="0,3" GroupName="Quality" />
                <RadioButton Content="{Binding QualityLowTitle}" IsChecked="{Binding QualityLow}" Margin="0,3" GroupName="Quality" />
                <TextBlock Text="{Binding QualityCaption}" Foreground="Gray" TextWrapping="Wrap" Margin="0,5,0,20" />
                <CheckBox Content="Record microphone" IsChecked="{Binding RecordMicrophone}" IsEnabled="{Binding MicrophoneEnabled}" />
                <TextBlock Text="{Binding MicrophoneFormatNote}" Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0" />
                <StackPanel Margin="0,8,0,0" Visibility="{Binding ShowsMicrophoneDenied, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="Snapper doesn't have access to the microphone." Foreground="Gray" TextWrapping="Wrap" />
                    <Button Content="Open Privacy Settings" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OpenMicrophonePrivacy" Padding="10,3" />
                </StackPanel>
            </StackPanel>
        </local:SettingsTabItem>
    </TabControl>
</Window>
