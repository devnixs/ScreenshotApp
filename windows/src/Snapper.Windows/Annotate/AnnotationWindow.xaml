<Window x:Class="Snapper.Windows.Annotate.AnnotationWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ResizeMode="CanResize" ShowInTaskbar="True" WindowStartupLocation="Manual" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="RadioButton">
                    <Border x:Name="ButtonBorder" CornerRadius="3" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1">
            <DockPanel Focusable="False" FocusManager.IsFocusScope="False" KeyboardNavigation.TabNavigation="None" x:Name="ToolbarRow" Margin="6,3" LastChildFill="False">
                <StackPanel x:Name="ActionsPanel" DockPanel.Dock="Right" Orientation="Horizontal"/>
                <StackPanel x:Name="ToolsPanel" Orientation="Horizontal"/>
            </DockPanel>
        </Border>
        <Grid x:Name="CanvasHost"/>
    </DockPanel>
</Window>
