// Local development defaults to ad hoc signing (Sign to Run Locally), without a team.
// For a stable identity, create ignored Config/Local.xcconfig with:
// DEVELOPMENT_TEAM = <TEAMID>
// CODE_SIGN_IDENTITY = Apple Development
// Ad hoc signatures change on every rebuild and can reset Screen Recording (TCC)
// permission. Use a real team identity when iterating on capture code.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
#include? "Local.xcconfig"
